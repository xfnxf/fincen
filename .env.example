# Copy to .env on the server (never commit the real one).
NODE_ENV=production
PORT=3000
SITE_NAME=Fincen
# Public address, used in emailed links. No trailing slash.
SITE_URL=https://example.com
# Folder for the SQLite database. Must be on a disk that survives restarts.
DATA_DIR=/data
# Set to 1 when the app sits behind a proxy or load balancer (it does on most hosts).
TRUST_PROXY=1
# Outgoing mail for password resets. Leave empty to print emails to the log instead.
SMTP_URL=smtps://USERNAME:PASSWORD@smtp.example.com:465
MAIL_FROM=Fincen <no-reply@example.com>
# Membership payments through NOWPayments. Leave both empty to keep memberships off on the live site.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Only while testing against their sandbox:
# NOWPAYMENTS_API_URL=https://api-sandbox.nowpayments.io/v1
