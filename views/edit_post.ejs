<%- include('partials/header', { crumbs: [['Thread', '/t/' + post.thread_id], ['Edit reply']] }) %>
<div class="mid">
  <h1>Edit reply</h1>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <form class="box" method="post" action="/p/<%= post.id %>/edit">
    <div class="box-body">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="field">
        <textarea name="body" rows="10" maxlength="10000" required data-count autofocus><%= post.body %></textarea>
        
      </div>
      <div class="actions">
        <button type="submit" class="primary">Save changes</button>
        <a href="/t/<%= post.thread_id %>#p<%= post.id %>">Cancel</a>
      </div>
    </div>
  </form>
</div>
<%- include('partials/footer') %>
